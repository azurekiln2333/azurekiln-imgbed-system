# 服务配置
PORT=4000

# JWT 配置
JWT_SECRET=your_jwt_secret_change_this_to_a_long_random_string
JWT_EXPIRES=7d

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=imagehost
DB_CONNECTION_LIMIT=10

# 默认 AList 存储配置
ALIST_URL=http://localhost:5244
ALIST_TOKEN=your_alist_token
ALIST_USERNAME=
ALIST_PASSWORD=
ALIST_MOUNT_PATH=/hi168
