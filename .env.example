# Docker 部署配置。复制为 .env 后填写；.env 不会提交到 Git。

# 镜像与发布端口。默认只发布到宿主机回环，供宿主机 Nginx 反代；
# 需要直接对外访问时把 IMGBED_BIND_HOST 改为 0.0.0.0。
IMGBED_IMAGE=ghcr.io/azurekiln2333/azurekiln-imgbed-system:latest
IMGBED_BIND_HOST=127.0.0.1
IMGBED_PORT=8080

# 后端配置。容器内 PORT 固定为 4000，不要改。
JWT_SECRET=
JWT_EXPIRES=7d

# 数据库。容器走桥接网络，通过 host.docker.internal 连接宿主机 MySQL：
# 1) mysqld 的 bind-address 需要 0.0.0.0（或至少包含 docker0 网桥地址）；
# 2) 账号要允许容器网段登录，例如
#    CREATE USER 'imgbed'@'%' IDENTIFIED BY '...';
#    GRANT ALL ON imagehost.* TO 'imgbed'@'%';
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=imgbed
DB_PASSWORD=
DB_NAME=imagehost
DB_CONNECTION_LIMIT=10

# AList。部署在宿主机时同样使用 host.docker.internal。
ALIST_URL=http://host.docker.internal:5244
ALIST_TOKEN=
ALIST_USERNAME=
ALIST_PASSWORD=
ALIST_MOUNT_PATH=/hi168

# Watchtower 检查镜像更新的间隔秒数，默认 10 分钟。
WATCHTOWER_POLL_INTERVAL=600
